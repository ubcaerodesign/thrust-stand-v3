        ESC["D-Shot ESC + Brushless Motor"]:::hw
        Sensors["4x Load Cell Channels<br/>Voltage & Current Sensors"]:::hw
    end

    UI_Dash <== "Local WebSocket (JSON Telemetry Stream)" ==> WS_Router
    UI_Comm --> WS_Router

    WS_Router --> Watchdog
